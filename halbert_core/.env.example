# Halbert Configuration - Phase 36 Agent
# Copy this file to .env and modify as needed
# Usage: source .env && python -m halbert_core.dashboard

# ============================================================================
# AGENT STATE MACHINE (Phase 36)
# ============================================================================

# Enable the new agent state machine (required to use Phase 36 features)
HALBERT_USE_NEW_AGENT=true

# Percentage of sessions using new agent (0-100)
# Use for gradual rollout: start at 10, increase as confidence grows
HALBERT_AGENT_ROLLOUT=100

# Enable CRAG (Corrective RAG) evaluation
# Evaluates context confidence before responding
HALBERT_USE_CRAG=true

# Enable streaming responses (SSE)
HALBERT_USE_STREAMING=true

# Enable tool safety checks (strongly recommended)
HALBERT_USE_TOOL_SAFETY=true

# Maximum reasoning loops before forcing response
HALBERT_MAX_AGENT_LOOPS=5

# CRAG confidence threshold (0.0-1.0)
# Higher = stricter, may trigger more re-retrieval
HALBERT_CRAG_THRESHOLD=0.7

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Enable web search tool (DuckDuckGo)
HALBERT_ENABLE_WEB_SEARCH=true

# Enable code execution (use with caution)
HALBERT_ENABLE_CODE_EXEC=false

# ============================================================================
# USER OVERRIDES (comma-separated user IDs)
# ============================================================================

# Users who always get the new agent (for testing)
# HALBERT_FORCE_NEW_AGENT_USERS=admin,tester

# Users who never get the new agent (for safety)
# HALBERT_EXCLUDE_NEW_AGENT_USERS=production-user

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Ollama (local LLM runtime)
OLLAMA_HOST=http://localhost:11434
# Models are chosen in Settings → AI Models (models.yml), not here.
# OLLAMA_MODEL=<a model available on your Ollama endpoint>

# Hosted API provider (optional)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=<model id from your provider>

# ============================================================================
# STORAGE
# ============================================================================

# Conversation storage directory
# HALBERT_CONVERSATIONS_DIR=~/.halbert/conversations

# Metrics retention (hours)
# HALBERT_METRICS_RETENTION=24

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
HALBERT_LOG_LEVEL=INFO

# ============================================================================
# DASHBOARD
# ============================================================================

# Dashboard port
HALBERT_DASHBOARD_PORT=8000

# Enable CORS for development
HALBERT_ENABLE_CORS=true
