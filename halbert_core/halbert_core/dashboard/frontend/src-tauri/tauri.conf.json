{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halbert",
  "version": "0.1.1",
  "identifier": "ai.halbert.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Halbert",
        "width": 1600,
        "height": 1000,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-powered system administration assistant",
    "longDescription": "Halbert is an AI-powered system administration assistant that helps you manage your computer with natural language. It provides intelligent insights about services, storage, network, security, and more.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
