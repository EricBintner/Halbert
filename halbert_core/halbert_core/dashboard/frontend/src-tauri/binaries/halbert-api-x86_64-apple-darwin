#!/bin/bash
# halbert-api — starts the Halbert dashboard backend (FastAPI/uvicorn) for the
# Tauri shell. Tauri bundles this as an external binary (tauri.conf.json
# bundle.externalBin) and launches it as a sidecar; the frontend talks to it
# over HTTP on $HALBERT_PORT.
#
# Launches the ASGI app directly with uvicorn (same form as scripts/dev-*.sh);
# `python -m halbert_core.dashboard` is not used because its __main__ imports a
# `create_dashboard_app` symbol that app.py does not define.
#
# Environment:
#   HALBERT_REPO_ROOT  Halbert checkout to run from. Defaults to walking up from
#                      this script until halbert_core/pyproject.toml is found,
#                      then ~/.local/share/halbert/repo.
#   HALBERT_PORT       Port to listen on (default 8000, matches the vite proxy).
#   HALBERT_HOST       Host to bind (default 127.0.0.1).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_repo_root() {
    # Walk up from $1 until a directory containing halbert_core/pyproject.toml.
    local d="$1"
    while [ "$d" != "/" ]; do
        if [ -f "$d/halbert_core/pyproject.toml" ]; then
            printf '%s\n' "$d"; return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}

if [ -n "${HALBERT_REPO_ROOT:-}" ]; then
    REPO_ROOT="$HALBERT_REPO_ROOT"
elif REPO_ROOT="$(find_repo_root "$SCRIPT_DIR")"; then
    :
elif [ -f "$HOME/.local/share/halbert/repo/halbert_core/pyproject.toml" ]; then
    # Documented install location for packaged builds without a checkout nearby.
    REPO_ROOT="$HOME/.local/share/halbert/repo"
else
    echo "halbert-api: cannot locate Halbert repo root; set HALBERT_REPO_ROOT" >&2
    exit 1
fi

# Prefer the repo's venv (has fastapi/uvicorn/haloysius); fall back to python3.
PYTHON="$REPO_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
    PYTHON="$(command -v python3)"
fi

export HALBERT_PORT="${HALBERT_PORT:-8000}"
export HALBERT_HOST="${HALBERT_HOST:-127.0.0.1}"

# On Apple Silicon the venv's Python is a universal2 binary. When the Tauri
# shell plugin spawns this script, the child process can inherit the x86_64
# slice (the Rosetta default for universal binaries under some conditions),
# and the first compiled extension — pydantic_core — dies with
# "incompatible architecture (have 'arm64', need 'x86_64')", which surfaces
# as "FastAPI not installed." Forcing the arm64 slice fixes it. This matches
# the `arch -arm64` prefix the test runner needs (see AGENTS.md).
#
# `uname -m` is no good here: it reports the *process* architecture, which is
# x86_64 inside a Tauri-spawned shell. `sysctl hw.optional.arm64` reports the
# *hardware* capability, which is 1 on Apple Silicon regardless of the
# current slice.
ARCH_PREFIX=""
if [ "$(uname -s)" = "Darwin" ] && [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
    ARCH_PREFIX="arch -arm64"
fi

# `exec` is load-bearing for shutdown: the Tauri shell kills the pid it
# spawned, and with exec that pid *is* uvicorn.
cd "$REPO_ROOT"
exec $ARCH_PREFIX "$PYTHON" -m uvicorn halbert_core.dashboard.app:app \
    --host "$HALBERT_HOST" --port "$HALBERT_PORT" "$@"
