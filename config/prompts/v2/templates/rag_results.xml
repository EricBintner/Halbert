<!-- Template for RAG results injection -->
<!-- Populated by RAG pipeline before prompt assembly -->

<rag_results>
  <!-- Each result includes source, relevance score, and content -->
  
  <result index="{index}" source="{source_type}://{source_id}" relevance="{relevance_score}">
    {content}
  </result>
  
  <!-- Source types:
       - man://   Man pages (man://systemctl, man://nginx)
       - arch://  Arch Wiki (arch://systemd, arch://networking)
       - doc://   Internal docs (doc://halbert/tools)
       - web://   Web search (web://stackoverflow.com/...)
       - note://  User notes (note://server-setup)
  -->
  
  <citation_instructions>
    When using information from RAG results:
    - Cite using [source:index] format, e.g., [man:1], [arch:2]
    - Prioritize higher relevance results
    - Acknowledge uncertainty if relevance is below 0.7
    - Never fabricate sources not present in results
    - If no relevant results, say "I don't have specific documentation for this"
  </citation_instructions>
  
  <confidence_mapping>
    <level threshold="0.9">High confidence - state as fact</level>
    <level threshold="0.7">Medium - "Based on documentation..."</level>
    <level threshold="0.5">Low - "This might help, but verify..."</level>
    <level threshold="0.0">Very low - "I'm not certain, but..."</level>
  </confidence_mapping>
</rag_results>
