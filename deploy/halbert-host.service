[Unit]
Description=Halbert Host Sysadmin Instance
After=network.target

[Service]
Type=simple
User=halbert
Group=halbert

# Instance identity
Environment=HALBERT_PERSONA_ID=halbert
Environment=HALBERT_SCENE_CONTEXT=Linux system administration

# Instance isolation
Environment=HALBERT_DATA_DIR=/var/lib/halbert
Environment=HALBERT_CONFIG_DIR=/etc/halbert
Environment=HALBERT_LOG_DIR=/var/log/halbert

# SourcePrep project
Environment=SOURCEPREP_PROJECT_ID=halbert-host

# Ports
Environment=HALBERT_PORT=8000
Environment=HALBERT_HOST=0.0.0.0
Environment=WYOMING_PORT=10400

ExecStart=/opt/halbert/bin/uvicorn halbert_core.dashboard.app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
