[Unit]
Description=Halbert Home Automation Instance
After=network.target homeassistant.service

[Service]
Type=simple
User=halbert
Group=halbert

# Instance identity
Environment=HALBERT_PERSONA_ID=home
Environment=HALBERT_SCENE_CONTEXT=smart home automation
Environment=HALBERT_VARIANT=home

# Instance isolation
Environment=HALBERT_DATA_DIR=/var/lib/halbert-home
Environment=HALBERT_CONFIG_DIR=/etc/halbert-home
Environment=HALBERT_LOG_DIR=/var/log/halbert-home

# Ports
Environment=HALBERT_PORT=8001
# SEC-1: this unit shipped binding 0.0.0.0 with no authentication at all,
# which put an arbitrary-file-write API and a PTY on the LAN. The dashboard
# now refuses a non-loopback bind unless HALBERT_API_TOKEN is set, so if you
# genuinely want this reachable off-box: set that token here, put TLS in
# front, and understand that the token then crosses your LAN on every call.
Environment=HALBERT_HOST=127.0.0.1
Environment=WYOMING_PORT=10401

# Wyoming voice agent
Environment=WYOMING_ENABLED=1

ExecStart=/opt/halbert/bin/uvicorn halbert_core.dashboard.app:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
