(version 1)
(deny default)

; Exec + fork. Note: seatbelt refuses setuid binaries under ANY profile,
; so ps/top are unreachable here regardless of what we allow.
(allow process-exec)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)

; dyld on macOS 26 reads the data of "/" itself before it maps anything;
; without this every exec dies with SIGABRT before main().
(allow file-read-metadata)
(allow file-read-data (literal "/"))

; The OS: binaries, libraries, the dyld cryptex, system config.
(allow file-read*
  (subpath "/bin") (subpath "/sbin")
  (subpath "/usr/bin") (subpath "/usr/sbin") (subpath "/usr/lib")
  (subpath "/usr/libexec") (subpath "/usr/share")
  (subpath "/System")
  (subpath "/Library/Preferences")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/opt/homebrew"))

; Live machine state the diagnostics are actually for.
(allow file-read* (subpath "/private/var/log") (subpath "/private/var/run"))

; Consented read roots (realpath'd by the caller) go here.
(allow file-read* (subpath "/private/tmp/sbxr"))

; Consented write roots (realpath'd by the caller) go here.
(allow file-write* (subpath "/private/tmp/sbxw"))

; The tty and the null devices, so a PTY command can actually talk.
(allow file-read* (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/dtracehelper") (literal "/dev/tty"))
(allow file-write-data (literal "/dev/null") (literal "/dev/stdout") (literal "/dev/stderr") (literal "/dev/tty"))
(allow file-ioctl (literal "/dev/tty") (literal "/dev/null") (literal "/dev/dtracehelper"))
