# Phase 25: Mac code is now PUBLIC
# halbert-mac/ - now public for App Store strategy
# data/macos/ - Mac-specific knowledge base (public)
# data/bsd/ - BSD knowledge base (public)
# data/common/ - Cross-platform knowledge (public)

# Mac Build Artifacts
*.app
*.dmg
*.pkg
build-mac/
dist-mac/

# Release artifacts
*.tar.gz
*.zip.backup
release-temp/
release/

# Maintenance scripts (one-time use)
scripts/maintenance/
scripts/temp/

# Mac app packaging (keep private - contains signing keys)
mac-app/signing/
mac-app/certificates/

# Internal Documentation (keep private, not in public repo)
docs/

# Keep these public:
!docs/README.md

# Large data files & indices (hosted on HuggingFace, not in repo)
# RAG/vector indices - generated locally from datasets
data/.rag_indices/

# Scraped datasets - download from HuggingFace instead
data/linux/arch-wiki-full/
data/linux/arch-wiki-ext/
data/linux/serverfault/
data/linux/unix-se/
data/linux/man-pages/
*.jsonl

# Keep manifest for reference (describes available datasets)
!data/manifest.json

# Licence-gated corpus slices MUST be versioned. The blanket *.jsonl rule above
# silently kept these out of the repo, which left the SS64 quarantine committed
# without its Halbert-authored replacement — the exact state LEG-CRIT-01 exists
# to prevent. See documentation/legal/CORPUS-LICENSING-ARCHITECTURE.md.
!data/macos/support/*.jsonl
!data/non-commercial/**/*.jsonl

# SourcePrep staging output (generated from JSONL, 87MB of markdown)
data/staging/

.playwright-mcp/

# SourcePrep volatile index + agent context (auto-generated, machine-local; keep ignored)
.sourceprep/

# Storybook static build
storybook-static/

# Vendored fonts, synced from shared-tokens/fonts by scripts/sync_fonts.py
**/public/fonts/
packages/design-system/.storybook_home/

# Claude Code worktrees
.claude/worktrees/
